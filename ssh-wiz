            self.title = title
            self.entries: list = []
            self.cursor = 0
            self.scroll = 0
            self.filter = ""
            self.active = False
            self.error: str | None = None
            self.show_hidden = False

        @property
        def filtered(self) -> list:
            """Visible entries (hidden ones excluded unless ``show_hidden``), then
            fuzzy-matched against the current text filter."""
            f = self.filter.lower()
            rows = [e for e in self.entries if self.show_hidden or not e.hidden]
            if not f:
                return rows
            return [e for e in rows if fuzzy_match(f, e.name.lower())]

        def entry_at_cursor(self):
            """The entry under the cursor, i.e. the *visible* row at
            ``self.cursor``. The cursor indexes ``filtered`` (what is rendered),
            never ``entries`` — hidden entries are not shown, so they must not be
            addressable by space/F5/F8."""
            rows = self.filtered
            if not rows:
                return None
            if self.cursor >= len(rows):
                self.cursor = len(rows) - 1
            return rows[self.cursor]

        def render(self) -> Text:
            t = Text(end="")
            rows = self.filtered
            if not rows:
                if self.title == "remote" and self.error:
                    t.append("  remote listing failed: ", style="dim red")
                    t.append(self.error.strip().splitlines()[-1], style="red")
                    return t
                msg = "empty directory" if self.title == "local" else "loading…"
                t.append(f"  {msg}", style="dim")
                return t
            name_w = min(45, max(14, max(len(e.name) for e in rows) + 2))
            height = max(1, self.size.height)
            if self.cursor >= len(rows):
                self.cursor = len(rows) - 1
            crow = self.cursor
            self.scroll = min(self.scroll, crow)
            if crow >= self.scroll + height - 1:
                self.scroll = crow - height + 2
            self.scroll = max(0, self.scroll)
            for r in range(self.scroll, min(len(rows), self.scroll + height)):
                e = rows[r]
                box = "☑" if e.selected else "☐"
                # The ☑/☐ icon is the selection indicator, so selected rows stay
                # un-highlighted. The cursor row gets a *subtle* background (not the
                # harsh white of reverse) so you always know where you are.
                row_style = Style(bgcolor="#26405b") if r == self.cursor else Style()
                name = e.name + ("/" if (e.is_dir and not e.is_symlink) else "")
                line = Text()
                line.append(f"{box} ", style=("green" if e.selected else "dim"))
                line.append(f"{name:<{name_w}}", style=row_style)
                if e.size:
                    line.append(fmt_size(e.size), style=row_style)
                t.append_text(line)
                t.append("\n")
            return t

