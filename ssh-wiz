def _ssh_config_path() -> Path:
    """~/.ssh/config, or $SSH_CONFIG if set (ssh honors the same variable)."""
    return Path(os.environ.get("SSH_CONFIG")
                or (Path.home() / ".ssh" / "config")).expanduser()


SSH_CONFIG = _ssh_config_path()
CONFIG_DIR = Path.home() / ".config" / "ssh-wiz"
STATE_DIR = Path.home() / ".local" / "state" / "ssh-wiz"
FAVORITES_FILE = CONFIG_DIR / "favorites"
USAGE_FILE = STATE_DIR / "usage.json"
EXTRA_HOSTS_FILE = CONFIG_DIR / "hosts"
CATEGORIES_FILE = CONFIG_DIR / "categories"
OPTIONS_FILE = CONFIG_DIR / "options"           # ^o panel: which options
OPTION_STATE_FILE = STATE_DIR / "options.json"  # ^o panel: last values
# --demo: all data files are pointed at a temp dir with sample data
# (start_demo/stop_demo); the real config and state are never touched.
_PATH_ATTRS = ("SSH_CONFIG", "CONFIG_DIR", "STATE_DIR", "FAVORITES_FILE",
               "USAGE_FILE", "EXTRA_HOSTS_FILE", "CATEGORIES_FILE",
               "OPTIONS_FILE", "OPTION_STATE_FILE")
# Header written to a freshly created categories file (^g).
CATEGORIES_TEMPLATE = """\
# ssh-wiz categories — one rule per line:
#
#   <category>  <host pattern>  [color]
#
# - The first matching rule wins. Patterns are shell globs, matched
#   case-sensitively against the host name (extra hosts: their alias).
# - Hosts matching no rule go to OTHER.
# - Bare IPs in 100.64.0.0/10 (Tailscale) are auto-categorized as
#   TAILSCALE unless a rule matches first.
# - Tab order follows first appearance. Without a color, categories get
#   one from a fixed palette.
#
# Examples:
#   LAN     10.0.1.*      magenta
#   PROD    *.example.com
"""
DEMO = False      # demo mode active: sample data, no real connections
_demo_saved = None  # path values before start_demo (restored by stop_demo)
_demo_root = None   # demo temp dir
OTHER_CATEGORY = "OTHER"
ALL_CATEGORY = "ALL"
# Built-in IP ranges -> category (data, not code): checked after user
# rules, before OTHER. Add a line to auto-categorize another range;
# repeat the category name to union several CIDRs. Tabs, order and
# colors all follow from this table (CIDR works for IPv4 and IPv6).
BUILTIN_RANGES = (
    # category     CIDR             tab color
    ("TAILSCALE", "100.64.0.0/10", "#32bea6"),  # Tailscale CGNAT
)
_RANGE_NETS = tuple((cat, ipaddress.ip_network(cidr), color)
                    for cat, cidr, color in BUILTIN_RANGES)
CATEGORY_COLORS = ("green", "cyan", "magenta", "yellow", "blue", "red",
                   "bright_cyan", "bright_yellow")
USER_COLORS = ("bright_red", "bright_green", "bright_yellow", "bright_blue",
               "bright_magenta", "bright_cyan", "red", "green", "blue",
               "magenta", "cyan", "yellow", "grey82", "bright_black",
               "dark_orange", "bright_white")
AT_COLOR = "bold grey63"
COL_SEP = " │ "  # dim column separator in host rows


@dataclass
class Host:
    """One connectable host (~/.ssh/config entry or extra-hosts file line)."""
    name: str                 # unique key: config name, or 'name (user)' for a
                              # second+ user of the same host
    display: str              # plain 'user@host[:port]' (status lines, no-user rows)
    target: str               # what is passed to ssh
    label: str = ""           # name column in TUI/-l (defaults to name)
    category: str = OTHER_CATEGORY
    user: str | None = None       # display only (ssh resolves it from config)
    host: str | None = None       # display only
    port: str | None = None       # display only
    cmd_port: str | None = None   # passed as -p (extra hosts aren't in config)
    principal: str | None = None  # GSSAPI-style user containing '@'
    identityfile: str | None = None
    extra: str = ""             # extra ssh args (extra hosts only)


def _valid_color(c: str) -> bool:
    try:
        Style.parse(c)
        return True
    except Exception:  # noqa: BLE001 - any parse failure means "not a valid color"
        return False


def user_color(user: str) -> str:
    """Stable per-user color (crc32, so it's the same across runs)."""
    return USER_COLORS[zlib.crc32(user.encode()) % len(USER_COLORS)]


def tmux_session_name(host: Host) -> str:
    """Per-host tmux session name (tmux forbids '.' and ':' in names)."""
    return "wiz-" + re.sub(r"[.:@ ()]+", "-", host.name).strip("-")


def tmux_available() -> bool:
    """Whether tmux is installed locally (practical proxy: the session
    itself runs on the remote host)."""
    return shutil.which("tmux") is not None


def category_order(hosts: list[Host], rules: list) -> list:
    """[ALL, <cats in file order>, <built-in cats with hosts>, OTHER]."""
    cats = [ALL_CATEGORY]
    for cat, _pattern, _color in rules:
        if cat not in cats:
            cats.append(cat)
    for cat, _cidr, _color in BUILTIN_RANGES:
        if cat not in cats and any(h.category == cat for h in hosts):
            cats.append(cat)
    if any(h.category == OTHER_CATEGORY for h in hosts):
        cats.append(OTHER_CATEGORY)
    return cats


def category_colors(hosts: list[Host], rules: list) -> dict:
    """{category: color} — explicit color from the rules wins,
    otherwise a distinct palette color by order of first appearance."""
    cats = category_order(hosts, rules)
    colors = {}
    for cat, _pattern, color in rules:
        if color and cat not in colors:
            colors[cat] = color
    for cat, _cidr, color in BUILTIN_RANGES:
        colors.setdefault(cat, color)
    for i, cat in enumerate(cats):
        if cat in (ALL_CATEGORY, OTHER_CATEGORY) or cat in colors:
            continue
        colors[cat] = CATEGORY_COLORS[max(0, i - 1) % len(CATEGORY_COLORS)]
    colors.setdefault(OTHER_CATEGORY, "grey62")
    return colors


# --------------------------------------------------------------- storage

def load_usage() -> dict:
    """{host: [connect timestamps]} — malformed entries are dropped, so a
    hand-edited usage.json can never crash the tool."""
    try:
        data = json.loads(USAGE_FILE.read_text())
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    usage = {}
    for name, ts in data.items():
        if not isinstance(ts, list):
            continue
        clean = [t for t in ts
                 if isinstance(t, (int, float)) and not isinstance(t, bool)]
        if clean:
            usage[name] = clean
    return usage


def record_use(name: str) -> None:
    usage = load_usage()
    ts = usage.get(name, [])
    ts.append(time.time())
    usage[name] = ts[-50:]
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = USAGE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(usage))
    os.replace(tmp, USAGE_FILE)


def load_favorites() -> list:
    try:
        text = FAVORITES_FILE.read_text()
    except OSError:
        return []
    return [l.strip() for l in text.splitlines()
            if l.strip() and not l.startswith("#")]


def toggle_favorite_file(name: str) -> bool:
    favs = load_favorites()
    if name in favs:
        favs.remove(name)
    else:
        favs.append(name)
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = FAVORITES_FILE.with_suffix(".tmp")
    tmp.write_text("\n".join(favs) + "\n")
    os.replace(tmp, FAVORITES_FILE)
    return name in favs


# ----------------------------------------------------------------- hosts

def _default_user() -> str:
    return os.environ.get("USER") or os.environ.get("LOGNAME") or "user"


def parse_ssh_config(path: Path) -> tuple[dict, list]:
    """Parse ~/.ssh/config -> (hosts dict, ordered names).

    ssh semantics: first value seen wins per host (port, identityfile).
    User is the exception: every distinct user across the host's blocks
    is kept, in order of appearance, so the picker can offer each one.
    Match blocks are skipped.
    Comments: a '#' at line start, or preceded by whitespace, starts a
    comment.
    """
    hosts: dict = {}
    order: list = []
    if not path.exists():
        return hosts, order
    current: list = []
    in_match = False
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 1)
        if len(parts) < 2:
            continue
        key, value = parts[0].lower(), parts[1].strip()
        m = re.search(r"(^|\s)#", value)
        if m:
            value = value[:m.start()].strip()
            if not value:
                continue
        if key == "match":
            in_match = True
            current = []
        elif key == "host":
            in_match = False
            current = [n for n in value.split() if not any(c in n for c in "*?")]
            for n in current:
                if n not in hosts:
                    hosts[n] = {"users": [], "port": None, "identityfile": None}
                    order.append(n)
        elif in_match or not current:
            continue
        elif key == "user":
            for n in current:
                if value not in hosts[n]["users"]:
                    hosts[n]["users"].append(value)
        elif key in ("port", "identityfile"):
            for n in current:
                if hosts[n][key] is None:
                    hosts[n][key] = value
    return hosts, order


def parse_extra_hosts(path: Path) -> list:
    """~/.config/ssh-wiz/hosts — one per line:  name  user@host[:port]  [extra ssh args]"""
    entries = []
    if not path.exists():
        return entries
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 2)
        if len(parts) < 2:
            continue
        extra = parts[2] if len(parts) > 2 else ""
        if extra:
            try:
                shlex.split(extra)
            except ValueError:
                print(f"ssh-wiz: ignoring malformed extra args: {line!r}",
                      file=sys.stderr)
                extra = ""
        entries.append({
            "name": parts[0],
            "target": parts[1],
            "extra": extra,
        })
    return entries


def load_category_rules(path: Path) -> list:
    """~/.config/ssh-wiz/categories -> [(category, pattern, color|None), ...]."""
    rules = []
    if not path.exists():
        return rules
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 2)
        if len(parts) < 2:
            continue
        color = parts[2].strip() if len(parts) > 2 else None
        if color and not _valid_color(color):
            color = None
        rules.append((parts[0], parts[1].strip(), color))
    return rules


def range_category(s: str) -> str | None:
    """Built-in category (BUILTIN_RANGES) for a bare IP string, or None."""
    try:
        ip = ipaddress.ip_address(s)
    except ValueError:
        return None
    for cat, net, _color in _RANGE_NETS:
        if ip in net:
            return cat
    return None


def host_category(name: str, rules: list, target_host: str | None = None) -> str:
    """Category for a host, given all the info we have about it.

    name        — what user rules match (config name / extra alias)
    target_host — the ssh target's host part (extra hosts only)
    Precedence: first matching user rule > built-in IP ranges > OTHER.
    """
    for cat, pattern, _color in rules:
        if fnmatch.fnmatchcase(name, pattern):
            return cat
    for s in (name, target_host):
        if s:
            cat = range_category(s)
            if cat:
                return cat
    return OTHER_CATEGORY


def build_hosts(rules: list | None = None) -> list[Host]:
    if rules is None:
        rules = load_category_rules(CATEGORIES_FILE)
    cfg, order = parse_ssh_config(SSH_CONFIG)
    hosts = []
    for name in order:
        h = cfg[name]
        port = h["port"]
        users = h["users"] or [_default_user()]
        for i, user in enumerate(users):
            # First user: the plain config name (ssh resolves it, first
            # value wins). Later users: separate entry with a unique name
            # and an explicit user@host target (ssh still applies the
            # config for the host: port, identityfile, ...).
            entry = name if i == 0 else f"{name} ({user})"
            target = name if i == 0 else f"{user}@{name}"
            if "@" in user:  # e.g. GSSAPI principal: show host, user in parens
                display = name + (f":{port}" if port and port != "22" else "") + f" ({user})"
                hosts.append(Host(
                    name=entry, display=display, target=target, label=name,
                    user=None, host=name, port=port, principal=user,
                    identityfile=h["identityfile"],
                    category=host_category(name, rules),
                ))
            else:
                display = f"{user}@{name}" + (f":{port}" if port and port != "22" else "")
                hosts.append(Host(
                    name=entry, display=display, target=target, label=name,
                    user=user, host=name, port=port,
                    identityfile=h["identityfile"],
                    category=host_category(name, rules),
                ))
    for e in parse_extra_hosts(EXTRA_HOSTS_FILE):
        if any(h.name == e["name"] for h in hosts):
            continue
        target = e["target"]
        user, at, rest = target.partition("@")
        if not at:  # no user given: whole target is the host
            user, rest = "", target
        hostpart, port = rest, ""
        inner, sep, maybe_port = rest.rpartition(":")
        if sep and maybe_port.isdigit():
            if inner.startswith("[") and inner.endswith("]"):
                hostpart, port = inner[1:-1], maybe_port  # [v6]:port
            elif ":" not in inner:
                hostpart, port = inner, maybe_port  # host:port
        # else: bare host, or bare IPv6 (no port)
        user = user or _default_user()
        display = user + "@" + hostpart + (f":{port}" if port else "")
        hosts.append(Host(
            name=e["name"], display=display, target=target,
            user=user, host=hostpart, port=port or None,
            cmd_port=port or None,
            extra=e["extra"],
            category=host_category(e["name"], rules, hostpart),
        ))
    return hosts


def _append_display(line: Text, h: Host) -> None:
    """Append the host's 'user@host[:port]' with per-user colors to line."""
    if h.principal:  # e.g. GSSAPI principal: host (user)
        line.append(h.host, style="bold")
        if h.port and h.port != "22":
            line.append(f":{h.port}", style="dim")
        line.append(f" ({h.principal})", style="dim")
    elif h.user:
        line.append(h.user, style=user_color(h.user))
        line.append("@", style=AT_COLOR)
        line.append(h.host, style="bold")
        if h.port and h.port != "22":
            line.append(f":{h.port}", style="dim")
    else:  # no user info (direct-connect fallback): plain display
        line.append(h.display)


def rank_hosts(hosts: list[Host]) -> tuple[list[Host], set]:
    """Favorites first, then alphabetical by the first column (label or
    name) so every category group reads A→Z; triage_hosts re-groups the
    non-favorites per category for the ALL view, preserving this order."""
    favs = set(load_favorites())

    def sort_key(h):
        return (0 if h.name in favs else 1,
                (h.label or h.name).lower(),
                h.name.lower())

    return sorted(hosts, key=sort_key), favs


def favorite_split(shown: list, favs: set) -> int:
    """Number of leading favorites in a ranked list (they form a prefix).

    rank_hosts puts favorites first; the list renders a separator line
    below the prefix when it is non-empty and not the whole list.
    """
    n = 0
    for h in shown:
        if h.name not in favs:
            break
        n += 1
    return n


def triage_hosts(shown: list, favs: set, cat_order: list) -> list:
    """Favorites first (rank order), then non-favorites grouped by category
    in cat_order (rank order within each group)."""
    by_cat: dict = {}
    for h in shown:
        if h.name not in favs:
            by_cat.setdefault(h.category, []).append(h)
    out = [h for h in shown if h.name in favs]
    for cat in cat_order:
        if cat != ALL_CATEGORY:
            out.extend(by_cat.pop(cat, []))
    out.extend(h for hs in by_cat.values() for h in hs)
    return out


# Toggleable ssh options for the ^o panel. The user file
# (~/.config/ssh-wiz/options) replaces these defaults; one per line:
#   label    option=value1|value2|...
# In the panel each option cycles off → v1 → … → off; enabled options are
# passed to ssh as -o <value>.
DEFAULT_OPTIONS = (
    # label      ssh option(s)
    ("no-pubkey", "PubkeyAuthentication=no"),
    ("x11", "ForwardX11=yes"),
    ("comp", "Compression=yes|auto"),
)


def _option_values(spec: str) -> tuple:
    """'Compression=yes|auto' -> ('Compression=yes', 'Compression=auto')."""
    name, eq, rest = spec.partition("=")
    if not eq or not name:
        return ()
    return tuple(f"{name}={v.strip()}" for v in rest.split("|") if v.strip())


def load_options(path: Path | None = None) -> list:
    """[(label, (option=value, ...))] for the ^o panel; the user file
    replaces the built-in defaults. Malformed lines are skipped."""
    text = None
    try:
        text = (path or OPTIONS_FILE).read_text()
    except OSError:
        pass
    if text is None:
        return [(label, _option_values(spec))
                for label, spec in DEFAULT_OPTIONS]
    opts, seen = [], set()
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 1)
        if len(parts) != 2:
            continue  # malformed: want label option=value
        label, values = parts[0], _option_values(parts[1])
        if label in seen or not values:
            continue
        seen.add(label)
        opts.append((label, values))
    return opts


def load_option_state(path: Path | None = None) -> dict:
    """{label: option=value} — last ^o panel values (off is not stored);
    malformed files are ignored."""
    try:
        data = json.loads((path or OPTION_STATE_FILE).read_text())
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    return {k: v for k, v in data.items()
            if isinstance(k, str) and isinstance(v, str)}


def save_option_state(state: dict, path: Path | None = None) -> None:
    path = path or OPTION_STATE_FILE
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(state))
    os.replace(tmp, path)


def build_ssh_cmd(host: Host, options: list | None = None,
                  tmux_mode: bool = False,
                  remote_cmd: list | None = None) -> list:
    cmd = ["ssh"]
    if tmux_mode:
        cmd.append("-t")
    for opt in options or []:
        cmd += ["-o", opt]
    if host.cmd_port:
        cmd += ["-p", host.cmd_port]
    if host.extra:
        try:
            cmd += shlex.split(host.extra)
        except ValueError:
            pass  # malformed extra args: already warned at parse time
    cmd.append(host.target)
    if tmux_mode:
        cmd += ["tmux", "new", "-A", "-s", tmux_session_name(host)]
    if remote_cmd:
        cmd += remote_cmd
    return cmd


@dataclass
class FileEntry:
    """One file/dir in a file-sync panel (local or remote)."""
    name: str
    path: str
    is_dir: bool = False
    is_symlink: bool = False
    size: int = 0
    selected: bool = False

    @property
    def hidden(self) -> bool:
        """A hidden ('dot') entry: its name starts with '.' (never '.'/'..',
        which are filtered out when the listing is built)."""
        return self.name.startswith(".")


def _sh_quote(s: str) -> str:
    """Quote a string for a POSIX shell: single quotes make it fully literal
    (spaces, globs, $, backticks, ...); an embedded single quote becomes
    '\'' (close, escaped quote, reopen)."""
    return "'" + s.replace("'", "'\\''") + "'"


def _rsync_ssh_shell(host: Host, options: list | None = None) -> str:
    """The `-e` shell rsync uses to reach the host: ssh with the same
    port/identityfile/options ssh would (ssh's port flag is -p, lowercase).
    ControlMaster multiplexes every sync-screen connection (listing,
    version probe, delete, transfer) over one SSH socket: the first
    operation pays the handshake, the rest reuse the master, which lingers
    60 s (ControlPersist) so consecutive directory hops stay fast. The
    ControlPath uses %C (a hash) so long user/host names cannot exceed the
    unix socket path limit."""
    parts = ["ssh"]
    if host.cmd_port:
        parts += ["-p", host.cmd_port]
    if host.identityfile:
        parts += ["-i", os.path.expanduser(host.identityfile)]
    parts += ["-o", "ControlMaster=auto",
              "-o", "ControlPath=%t/ssh-wiz-%C",
              "-o", "ControlPersist=60"]
    for opt in options or []:
        parts += ["-o", opt]
    if host.extra:
        try:
            parts += shlex.split(host.extra)
        except ValueError:
            pass  # malformed extra args: already warned at parse time
    return " ".join(parts)


def build_transfer_cmd(host: Host, options: list | None = None,
                       direction: str = "up",
                       sources: list | None = None,
                       dest: str = "~/",
                       progress: bool = False) -> list:
    """rsync command for a local<->remote move (local->remote push by default).

    direction='up'   : push local `sources` -> user@host:dest  (upload)
    direction='down' : pull user@host:sources -> local `dest`   (download)

    `dest` always gets a trailing slash so it behaves like a folder you drop
    things into (a file -> dest/file, a dir -> dest/dir/). Files/dirs are the
    item *itself* (no trailing slash on the source), so a directory lands as a
    new sub-directory rather than spilling its contents.

    `progress` adds --info=progress2 (live overall progress on stdout); needs
    rsync >= 3.1.0 on both ends, so callers gate it on the probed versions.
    """
    sources = list(sources or [])
    cmd = ["rsync", "-a", "-z", "-h", "-i", "-e", _rsync_ssh_shell(host, options)]
    if progress:
        cmd.append("--info=progress2")
    if direction == "up":
        for s in sources:
            cmd.append(os.path.expanduser(s))
        cmd.append(f"{host.target}:{dest.rstrip('/')}/")
    else:
        for s in sources:
            cmd.append(f"{host.target}:{s.lstrip('/')}")
        cmd.append(os.path.expanduser(dest).rstrip("/") + "/")
    return cmd


def list_local_dir(path: Path) -> list:
    """FileEntry list for a local directory (dirs first, then A->Z)."""
    entries: list = []
    try:
        with os.scandir(path) as it:
            for d in it:
                try:
                    is_link = d.is_symlink()
                    entries.append(FileEntry(
                        name=d.name, path=d.path,
                        is_dir=not is_link and d.is_dir(),
                        is_symlink=is_link,
                        size=0 if is_link
                        else d.stat(follow_symlinks=False).st_size))
                except OSError:
                    continue
    except OSError:
        return entries
    entries.sort(key=lambda e: (not e.is_dir, e.name.lower()))
    return entries


def parse_rsync_listing(output: str) -> list:
    """Parse `rsync --list-only` lines: 'perms size date time name' (name may
    contain spaces); dirs first, then A->Z."""
    entries: list = []
    for line in output.splitlines():
        fields = line.split(None, 4)
        if len(fields) < 5:
            continue
        perms, size, _date, _time, name = fields
        if name.startswith("./"):
            name = name[2:]
        if name in (".", ".."):
            continue
        try:
            size_i = int(size)
        except ValueError:
            size_i = 0
        entries.append(FileEntry(
            name=name, path=name,
            is_dir=perms.startswith("d"),
            is_symlink=perms.startswith("l"),
            size=size_i))
    entries.sort(key=lambda e: (not e.is_dir, e.name.lower()))
    return entries


def parse_itemize(line: str) -> tuple[str, str] | None:
    """Parse one `rsync --itemize-changes` line -> (type, name), or None.
    type is 'f' (file), 'd' (dir) or '=' (symlink)."""
    line = line.rstrip("\n")
    if " " not in line or len(line) < 12:
        return None
    code, name = line.split(" ", 1)
    ftype = code[1] if len(code) > 1 else ""
    if ftype == "d":
        name = name.rstrip("/")
        return ("d", name) if name not in ("", ".") else None
    if ftype in ("f", "="):
        if name.startswith("./"):
            name = name[2:]
        return (ftype, name) if name not in (".", "..") else None
    return None


# One --info=progress2 sample (rsync >= 3.1):
#   <size>  <pct>%  <speed>  <eta>  [(xfr#N, to-chk=A/B)]
# The size is either a raw byte count with locale digit grouping
# ('41,943,040', '42.621.440') or, with -h, a human-readable SI value
# ('41.94M', '41,94M'). Both decimal separators (',' and '.') are accepted,
# so the parse is locale-proof (the subprocess also runs with LC_ALL=C).
_PROGRESS_RE = re.compile(
    r"^(\d+(?:[.,]\d+)*)\s*([KMGTPE])?\s+"
    r"(\d+(?:[.,]\d+)?)\s*%\s+"
    r"(\d+(?:[.,]\d+)?)\s*(B|kB|MB|GB|TB|PB)/s"
    r".*?(?:\(xfr#(\d+), to-chk=\d+/\d+\))?\s*$")

_HUMAN_MULT = {"": 1, "K": 1000, "M": 10**6, "G": 10**9,
               "T": 10**12, "P": 10**15}
_SPEED_MULT = {"B": 1, "kB": 1000, "MB": 10**6, "GB": 10**9,
               "TB": 10**12, "PB": 10**15}


def _parse_rsync_size(raw: str, unit: str | None) -> int:
    """rsync size field -> int bytes (SI units when a suffix is present)."""
    if unit:
        return int(float(raw.replace(",", ".")) * _HUMAN_MULT[unit])
    return int(raw.replace(".", "").replace(",", ""))


def parse_progress(segment: str):
    """Parse one progress2 sample -> (bytes_done, pct, speed, xfr_done), or
    None. bytes_done is cumulative over the whole transfer; speed is rsync's
    own rate in bytes/s; xfr_done is None when the sample carries no
    (xfr#N, ...) suffix."""
    m = _PROGRESS_RE.match(segment.strip())
    if not m:
        return None
    size_raw, unit, pct_raw, speed_raw, speed_unit, xfr = m.groups()
    return (_parse_rsync_size(size_raw, unit),
            int(float(pct_raw.replace(",", "."))),
            float(speed_raw.replace(",", ".")) * _SPEED_MULT[speed_unit],
            int(xfr) if xfr else None)


def fmt_size(n: int) -> str:
    """Human-readable byte size (1.2M, 512B, ...)."""
    if n < 1024:
        return f"{n}B"
    for unit in ("K", "M", "G", "T"):
        n /= 1024
        if n < 1024:
            return f"{n:.0f}{unit}"
    return f"{n:.0f}P"


def fmt_speed(bps: float) -> str:
    """Bytes/second as a compact SI rate (7.9MB/s, 850kB/s, 120B/s)."""
    for unit, div in (("GB/s", 10**9), ("MB/s", 10**6), ("kB/s", 1000)):
        if bps >= div:
            return f"{bps / div:.1f}{unit}"
    return f"{bps:.0f}B/s"


_RSYNC_VER_RE = re.compile(r"version (\d+)\.(\d+)\.(\d+)")


def local_rsync_version() -> tuple | None:
    """(major, minor, patch) of the local rsync, or None if not installed."""
    try:
        out = subprocess.run(["rsync", "--version"], capture_output=True,
                             text=True, check=False)
    except (FileNotFoundError, OSError):
        return None
    m = _RSYNC_VER_RE.search(out.stdout)
    return tuple(int(x) for x in m.groups()) if m else None


def find_host(name: str) -> Host:
    hosts = build_hosts()
    for h in hosts:
        if h.name == name or h.target == name:
            return h
    # user@host completion where the user is the first/default user
    # (whose target is the bare host name): resolve to the matching entry.
    if "@" in name:
        user, _, hostpart = name.partition("@")
        for h in hosts:
            if h.host == hostpart and (h.user == user or h.principal == user):
                return h
    return Host(name=name, display=name, target=name)


def fuzzy_match(needle: str, haystack: str) -> bool:
    """True if every char of needle appears in haystack, in order.

    A superset of substring: 'rzn9' matches 'ryzen9'.
    """
    it = iter(haystack)
    return all(ch in it for ch in needle)


def copy_to_clipboard(text: str) -> bool:
    """Copy text via the first available clipboard tool."""
    for tool in (["wl-copy"], ["xclip", "-selection", "clipboard"],
                 ["xsel", "--clipboard", "--input"], ["pbcopy"]):
        if shutil.which(tool[0]):
            try:
                subprocess.run(tool, input=text.encode(), check=True, timeout=2)
                return True
            except Exception:  # noqa: BLE001, S112 - just try the next clipboard tool
                continue
    return False


def find_config_line(name: str):
    """1-based line of the 'Host <name>' block in ~/.ssh/config, or None."""
    try:
        lines = SSH_CONFIG.read_text().splitlines()
    except OSError:
        return None
    for i, raw in enumerate(lines, 1):
        parts = raw.split(None, 1)
        if len(parts) >= 2 and parts[0].lower() == "host" and name in parts[1].split():
            return i
    return None


