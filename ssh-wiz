def start_demo() -> Path:
    """Point all data files at a temp dir with built-in sample data.

    The real config and state are left untouched; stop_demo() restores
    the original paths and removes the temp dir.
    """
    global DEMO, _demo_saved, _demo_root
    global SSH_CONFIG, CONFIG_DIR, STATE_DIR
    global FAVORITES_FILE, USAGE_FILE, EXTRA_HOSTS_FILE, CATEGORIES_FILE
    global OPTIONS_FILE, OPTION_STATE_FILE
    root = Path(tempfile.mkdtemp(prefix="ssh-wiz-demo-"))
    _demo_saved = {a: globals()[a] for a in _PATH_ATTRS}
    _demo_root = root
    CONFIG_DIR = root / "config"
    STATE_DIR = root / "state"
    CONFIG_DIR.mkdir(parents=True)
    STATE_DIR.mkdir(parents=True)
    SSH_CONFIG = root / "ssh_config"
    FAVORITES_FILE = CONFIG_DIR / "favorites"
    USAGE_FILE = STATE_DIR / "usage.json"
    EXTRA_HOSTS_FILE = CONFIG_DIR / "hosts"
    CATEGORIES_FILE = CONFIG_DIR / "categories"
    OPTIONS_FILE = CONFIG_DIR / "options"
    OPTION_STATE_FILE = STATE_DIR / "options.json"
    SSH_CONFIG.write_text(DEMO_SSH_CONFIG)
    EXTRA_HOSTS_FILE.write_text(DEMO_EXTRA_HOSTS)
    CATEGORIES_FILE.write_text(DEMO_CATEGORIES)
    FAVORITES_FILE.write_text("web1.example.com\ngit.example.org\n")
    now = time.time()
    USAGE_FILE.write_text(json.dumps({
        "web1.example.com": [now - 86400],
        "db1.example.com": [now - 3600],
        "git.example.org": [now - 60],
        "web2.example.com": [now - 1800, now - 7200],
        "bastion.example.net": [now - 43200],
    }))
    DEMO = True
    return root


def stop_demo() -> None:
    """Restore the real data paths and remove the demo temp dir."""
    global DEMO, _demo_saved, _demo_root
    if _demo_saved is None:
        return
    for name, value in _demo_saved.items():
        globals()[name] = value
    DEMO = False
    shutil.rmtree(_demo_root, ignore_errors=True)
    _demo_saved = None
    _demo_root = None


# ------------------------------------------------------------------ CLI

def main() -> None:
    args = sys.argv[1:]
    demo = "--demo" in args
    if demo:
        args = [a for a in args if a != "--demo"]
        start_demo()
    try:
        run_main(args)
    finally:
        if demo:
            stop_demo()


def run_main(args: list) -> None:
    if not args:
        _tui()  # import textual and define the TUI classes (CLI paths skip it)
        SSHWiz().run()
        return
    if args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    if args[0] in ("-V", "--version"):
        print(f"ssh-wiz {__version__}")
        return
    if args[0] == "--complete":
        prefix = args[1] if len(args) > 1 else ""
        for c in complete_candidates(prefix):
            print(c)
        return
    if args[0] == "--complete-hosts":
        prefix = args[1] if len(args) > 1 else ""
        for c in complete_user_hosts(prefix):
            print(c)
        return
    if args[0] == "--completion":
        shell = args[1] if len(args) > 1 else ""
        script = COMPLETION_SCRIPTS.get(shell)
        if script is None:
            sys.exit(f"ssh-wiz: unknown completion shell: {shell} "
                     f"(want bash, zsh or fish)")
        print(script)
        return
    if args[0] in ("-l", "--list"):
        rules = load_category_rules(CATEGORIES_FILE)
        hosts, favs = rank_hosts(build_hosts(rules))
        colors = category_colors(hosts, rules)
        console = Console()
        for h in hosts:
            line = Text()
            line.append("★ " if h.name in favs else "  ",
                        style="bold yellow" if h.name in favs else "dim")
            line.append(f"{(h.label or h.name):<32}", style="bold")
            line.append(COL_SEP, style="dim")
            _append_display(line, h)
            if h.category and h.category != OTHER_CATEGORY:
                line.append(COL_SEP, style="dim")
                line.append(f"[{h.category}]",
                            style="bold " + colors.get(h.category, ""))
            if h.identityfile:
                line.append(" ")
                line.append(f"[{Path(h.identityfile).expanduser().name}]",
                            style="cyan dim")
            console.print(line)
        return
    if args[0] == "-f":
        if len(args) < 2:
            sys.exit("ssh-wiz: -f requires a host name")
        on = toggle_favorite_file(args[1])
        print(f"{'★ favorite' if on else 'unfavorited'}: {args[1]}")
        return
    password_mode = False
    tmux_mode = False
    rest = []
    for a in args:
        if a in ("-p", "--password"):
            password_mode = True
        elif a in ("-t", "--tmux"):
            tmux_mode = True
        elif a.startswith("-") and len(a) > 1:
            sys.exit(f"ssh-wiz: unknown option: {a} (see -h)")
        else:
            rest.append(a)
    if not rest:
        print(__doc__.strip())
        return
    host = find_host(rest[0])
    remote_cmd = rest[1:]
    if tmux_mode and remote_cmd:
        sys.exit("ssh-wiz: cannot combine -t with a remote command")
    if tmux_mode and not tmux_available():
        sys.exit("ssh-wiz: tmux is not installed")
    opts = load_options()
    state = load_option_state()
    options = [state[label] for label, values in opts
               if state.get(label) in values]
    if password_mode:  # -p: enable PubkeyAuthentication=no
        for _label, values in opts:
            if any(v.split("=", 1)[0] == "PubkeyAuthentication"
                   for v in values):
                for v in values:
                    if v.split("=", 1)[1] == "no":
                        options.append(v)
                        break
                break
    record_use(host.name)
    try:
        os.execvp("ssh", build_ssh_cmd(host, options, tmux_mode, remote_cmd))
    except OSError as e:
        sys.exit(f"ssh-wiz: cannot run ssh: {e}")


if __name__ == "__main__":
    main()
