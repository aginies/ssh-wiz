    def on_resize(self, event) -> None:
        self.refresh()


class SSHWiz(App):
    TITLE = "ssh-wiz"

    CSS = """
    #status {
        height: 1;
        background: $primary-background;
        color: $text;
        padding: 0 1;
    }
    #tabs {
        height: 2;
        background: $surface;
        color: $text;
        padding: 0 1;
        border-bottom: heavy $border;
    }
    #hints {
        height: 1;
        background: $surface;
        color: $text-muted;
        padding: 0 1;
    }
    """

    ENABLE_COMMAND_PALETTE = False

    def __init__(self) -> None:
        super().__init__()
        self.options = load_options()
        saved = load_option_state()
        self.option_state = {}
        for label, values in self.options:  # stale values dropped
            v = saved.get(label, "")
            self.option_state[label] = v if v in values else ""
        self.options_open = False
        self.tmux_mode = False
        self.connecting = False
        self.categories = [ALL_CATEGORY]
        self.cat_colors = {}
        self.current_cat = ALL_CATEGORY

    def compose(self) -> ComposeResult:
        yield Static("", id="status")
        yield Static("", id="tabs")
        yield OptionsPanel()
        yield CmdLine()
        yield HostList()
        yield Static(hints_text(), id="hints")

    # -- data

    def reload(self) -> None:
        rules = load_category_rules(CATEGORIES_FILE)
        hosts, favs = rank_hosts(build_hosts(rules))
        self.categories = category_order(hosts, rules)
        self.cat_colors = category_colors(hosts, rules)
        if self.current_cat not in self.categories:
            self.current_cat = ALL_CATEGORY
        hl = self.query_one(HostList)
        hl.hosts = hosts
        hl.favs = favs
        hl.apply_filter()
        self.update_tabs()
        self.update_status()

    def update_tabs(self) -> None:
        hl = self.query_one(HostList)
        counts: dict = {}
        for h in hl.hosts:
            counts[h.category] = counts.get(h.category, 0) + 1
        t = Text()
        for cat in self.categories:
            n = len(hl.hosts) if cat == ALL_CATEGORY else counts.get(cat, 0)
            color = self.cat_colors.get(cat, "")
            label = f" {cat} ({n}) "
            if cat == self.current_cat:
                t.append(label, style=f"{color} bold reverse")
            else:
                t.append(label, style=color)
        self.query_one("#tabs", Static).update(t)

    def switch_cat(self, delta: int) -> None:
        if len(self.categories) < 2:
            return
        i = self.categories.index(self.current_cat)
        self.current_cat = self.categories[(i + delta) % len(self.categories)]
        hl = self.query_one(HostList)
        hl.apply_filter()
        self.update_tabs()
        self.update_status()

    def update_status(self) -> None:
        hl = self.query_one(HostList)
        parts = []
        if DEMO:
            parts.append("[bold magenta]DEMO MODE[/] (sample data — "
                         "no real connections)")
        if self.option_state and any(self.option_state.values()):
            enabled = [l for l, _v in self.options
                       if self.option_state.get(l)]
            parts.append("opts: " +
                         " ".join(f"[bold]{escape(l)}[/]" for l in enabled))
        if self.tmux_mode:
            parts.append("[bold green]TMUX[/] (tmux new -A -s wiz-<host>)")
        if hl.filter:
            parts.append(f"filter: [bold]{escape(hl.filter)}[/]")
        parts.append(f"{len(hl.shown)}/{len(hl.hosts)} hosts")
        self.query_one("#status", Static).update("   ".join(parts))
        self.update_cmd()

    def update_cmd(self) -> None:
        # layout=True: a wrapped command changes the widget's auto height
        self.query_one(CmdLine).refresh(layout=True)

    def on_mount(self) -> None:
        if DEMO:
            self.title = "ssh-wiz (demo)"
        self.reload()
        self.query_one(HostList).focus()

    # -- actions

    def toggle_favorite(self) -> None:
        hl = self.query_one(HostList)
        if not hl.shown:
            return
        host = hl.shown[hl.cursor]
        is_fav = toggle_favorite_file(host.name)
        self.reload()
        for i, h in enumerate(hl.shown):
            if h.name == host.name:
                hl.cursor = i
                break
        hl.refresh()
        verb = "★ added to favorites" if is_fav else "removed from favorites"
        self.notify(f"{verb}: {host.name}", title="ssh-wiz")

    def connect_to(self, host: Host) -> None:
        if self.connecting:
            return
        if DEMO:
            cmd = " ".join(
                build_ssh_cmd(host, self.enabled_options(), self.tmux_mode))
            self.notify(f"demo mode — would run: {cmd}", title="ssh-wiz")
            record_use(host.name)  # demo state only: usage.json grows on connect
            self.reload()
            hl = self.query_one(HostList)
            for i, h in enumerate(hl.shown):
                if h.name == host.name:
                    hl.cursor = i
                    break
            hl.refresh()
            return
        cmd = build_ssh_cmd(host, self.enabled_options(), self.tmux_mode)
        self.connecting = True
        self.query_one("#status", Static).update(
            f"[bold cyan]⏳ ssh {escape(host.display)} — terminal handed over…[/]")
        record_use(host.name)
        try:
            with self.suspend():
                rc = subprocess.run(cmd, check=False).returncode
        except SuspendNotSupported:
            self.notify("terminal does not support suspend — run: " + " ".join(cmd),
                        severity="error")
            self.update_status()
            return
        finally:
            self.connecting = False
        self.reload()
        hl = self.query_one(HostList)
        for i, h in enumerate(hl.shown):
            if h.name == host.name:
                hl.cursor = i
                break
        hl.refresh()
        self.notify(f"ssh exit {rc}: {host.name}",
                    severity="information" if rc == 0 else "warning")

    def do_connect(self) -> None:
        hl = self.query_one(HostList)
        if not hl.shown:
            return
        self.connect_to(hl.shown[hl.cursor])

    # -- options panel (^o)

    def enabled_options(self) -> list:
        """Enabled 'option=value' strings, in panel order."""
        return [self.option_state[label]
                for label, _values in self.options
                if self.option_state.get(label)]

    def toggle_help(self) -> None:
        if isinstance(self.screen, HelpScreen):
            self.pop_screen()
        else:
            self.push_screen(HelpScreen())

    def toggle_options_panel(self) -> None:
        panel = self.query_one(OptionsPanel)
        if self.options_open:
            self.close_options_panel()
        else:
            if not self.options:
                self.notify(f"no ssh options defined ({OPTIONS_FILE})",
                            severity="warning")
                return
            panel.cursor = 0
            panel.styles.display = "block"  # DEFAULT_CSS hides it
            self.options_open = True
            panel.focus()
            self.query_one("#hints", Static).update(OPTIONS_HINTS)
            self.update_status()

    def close_options_panel(self) -> None:
        self.query_one(OptionsPanel).styles.display = "none"
        self.options_open = False
        self.query_one("#hints", Static).update(hints_text())
        self.query_one(HostList).focus()
        self.update_status()

    def options_key(self, key: str) -> None:
        panel = self.query_one(OptionsPanel)
        if key in ("escape", "ctrl+o"):
            self.close_options_panel()
        elif key == "up":
            panel.cursor = max(0, panel.cursor - 1)
            panel.refresh()
        elif key == "down":
            panel.cursor = min(len(self.options) - 1, panel.cursor + 1)
            panel.refresh()
        elif key in ("left", "right", "enter"):
            self.cycle_option(-1 if key == "left" else 1)

    def cycle_option(self, delta: int) -> None:
        panel = self.query_one(OptionsPanel)
        label, values = self.options[panel.cursor]
        n = len(values) + 1  # off + all values
        cur = self.option_state.get(label, "")
        i = (values.index(cur) if cur in values else -1) + delta
        i %= n
        self.option_state[label] = "" if i == n - 1 else values[i]
        save_option_state(self.option_state)
        panel.refresh()
        self.update_status()

    def edit_config(self) -> None:
        if DEMO:
            self.notify("demo mode — no real config to edit",
                        severity="warning")
            return
        hl = self.query_one(HostList)
        if not hl.shown:
            return
        host = hl.shown[hl.cursor]
        line = find_config_line(host.host or host.name)
        if line is None:
            line = 1
            self.notify(f"{host.name} not in ~/.ssh/config — opening top",
                        severity="warning")
        editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "vi"
        parts = shlex.split(editor)
        editor_bin = Path(parts[0]).name
        if editor_bin == "code":
            args = parts + ["-g", f"{SSH_CONFIG}:{line}"]
        elif editor_bin in ("vi", "vim", "nvim", "emacs", "micro"):
            args = parts + [f"+{line}", str(SSH_CONFIG)]
        else:
            args = parts + [str(SSH_CONFIG)]
            self.notify(f"{editor_bin} can't jump to a line — "
                        f"opened ~/.ssh/config at top", severity="warning")
        try:
            with self.suspend():
                subprocess.run(args, check=False)
        except SuspendNotSupported:
            self.notify("terminal does not support suspend", severity="error")
            return
        self.reload()

    def edit_categories(self) -> None:
        """Open the categories file in $EDITOR, then reload (tabs, colors
        and categorization rebuild). In demo mode the demo's temp file is
        edited — safe, and a nice live demo of re-categorization."""
        path = CATEGORIES_FILE
        if not path.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(CATEGORIES_TEMPLATE)
        editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "vi"
        args = shlex.split(editor) + [str(path)]
        try:
            with self.suspend():
                subprocess.run(args, check=False)
        except SuspendNotSupported:
            self.notify("terminal does not support suspend", severity="error")
            return
        self.reload()

    # -- keys

    def on_key(self, event: events.Key) -> None:
        hl = self.query_one(HostList)
        key = event.key
        if key in ("ctrl+c", "ctrl+q"):
            self.exit()
            event.stop()
        elif key in ("ctrl+h", "question_mark", "f1"):
            self.toggle_help()
            event.stop()
        elif self.options_open:
            self.options_key(key)
            event.stop()
        elif key == "backspace":
            hl.filter = hl.filter[:-1]
            hl.apply_filter()
            self.update_status()
            event.stop()
        elif key == "escape":
            if hl.filter:
                hl.filter = ""
                hl.apply_filter()
                self.update_status()
            event.stop()
        elif key == "up":
            hl.cursor = max(0, hl.cursor - 1)
            hl.refresh()
            self.update_cmd()
            event.stop()
        elif key == "down":
            if hl.shown:
                hl.cursor = min(len(hl.shown) - 1, hl.cursor + 1)
            hl.refresh()
            self.update_cmd()
            event.stop()
        elif key == "home":
            hl.cursor = 0
            hl.refresh()
            self.update_cmd()
            event.stop()
        elif key == "end":
            hl.cursor = max(0, len(hl.shown) - 1)
            hl.refresh()
            self.update_cmd()
            event.stop()
        elif key == "pageup":
            hl.cursor = max(0, hl.cursor - max(1, hl.size.height - 2))
            hl.refresh()
            self.update_cmd()
            event.stop()
        elif key == "pagedown":
            hl.cursor = min(max(0, len(hl.shown) - 1),
                            hl.cursor + max(1, hl.size.height - 2))
            hl.refresh()
            self.update_cmd()
            event.stop()
        elif key == "enter":
            self.do_connect()
            event.stop()
        elif key in ("tab", "right"):
            self.switch_cat(1)
            event.stop()
        elif key in ("shift+tab", "backtab", "left"):
            self.switch_cat(-1)
            event.stop()
        elif key == "ctrl+f":
            self.toggle_favorite()
            event.stop()
        elif key == "ctrl+o":
            self.toggle_options_panel()
            event.stop()
        elif key == "ctrl+t":
            if tmux_available():
                self.tmux_mode = not self.tmux_mode
                self.update_status()
            else:
                self.notify("tmux is not installed", severity="warning")
            event.stop()
        elif key == "ctrl+y":
            if hl.shown:
                host = hl.shown[hl.cursor]
                cmd = " ".join(build_ssh_cmd(host, self.enabled_options()))
                if copy_to_clipboard(cmd):
                    self.notify(f"copied: {cmd}")
                else:
                    self.notify(f"no clipboard tool (wl-copy/xclip/xsel/pbcopy) — {cmd}",
                                severity="warning")
            event.stop()
        elif key == "ctrl+e":
            self.edit_config()
            event.stop()
        elif key == "ctrl+g":
            self.edit_categories()
            event.stop()
        elif key == "ctrl+r":
            self.reload()
            event.stop()
        elif event.is_printable:
            hl.filter += event.character
            hl.apply_filter()
            self.update_status()
            event.stop()


# ----------------------------------------------------------- completion

# Flags offered for '-...' prefixes (single source of truth; the completion
# scripts only encode argument positions).
CLI_FLAGS = ("-l", "--list", "-f", "-p", "--password", "-t", "--tmux",
             "--demo", "--complete", "--completion",
             "-h", "--help", "-V", "--version")


def complete_candidates(prefix: str) -> list:
    """Completion candidates for prefix: flags (prefix match) if it starts
    with '-', otherwise host names (fuzzy, like the TUI filter)."""
    p = prefix.lower()
    if prefix.startswith("-"):
        return [f for f in CLI_FLAGS if f.startswith(p)]
    return [h.name for h in build_hosts() if fuzzy_match(p, h.name.lower())]


COMPLETION_SCRIPTS = {
    "bash": r"""# ssh-wiz bash completion — enable in .bashrc with:
#   eval "$(ssh-wiz --completion bash)"
__ssh_wiz() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    local hostpos=0
    COMPREPLY=()
    [[ "$COMP_CWORD" -eq 1 ]] && hostpos=1
    case "$prev" in -f|-p|-t) hostpos=1 ;; esac
    if [[ "$cur" == -* || "$hostpos" -eq 1 ]]; then
        local IFS=$'\n'
        COMPREPLY=( $(ssh-wiz --complete "$cur" 2>/dev/null) )
    fi
    # remote-command position: default (filename) completion applies
}
complete -o default -F __ssh_wiz ssh-wiz""",
    "zsh": r"""# ssh-wiz zsh completion — enable in .zshrc with:
#   eval "$(ssh-wiz --completion zsh)"
__ssh_wiz() {
    local cur="${words[CURRENT]}"
    local prev="${words[CURRENT-1]}"
    reply=()
    if [[ "$cur" == -* || "$CURRENT" -eq 2 || "$prev" == (-f -p -t) ]]; then
        local -a cands
        cands=("${(@f)$(ssh-wiz --complete "$cur" 2>/dev/null)}")
        (( ${#cands} )) && reply=($cands)
    else
        _files
    fi
}
(( $+functions[compdef] )) && compdef __ssh_wiz ssh-wiz""",
    "fish": r"""# ssh-wiz fish completion — enable in config.fish with:
#   ssh-wiz --completion fish | source
complete -c ssh-wiz -s l -l list -d 'list hosts (favorites first, A→Z), no TUI'
complete -c ssh-wiz -s f -r -d 'toggle favorite (takes host)'
complete -c ssh-wiz -s p -l password -d 'connect with -o PubkeyAuthentication=no'
complete -c ssh-wiz -s t -l tmux -d 'connect in per-host tmux session'
complete -c ssh-wiz -s h -l help -d 'show help'
complete -c ssh-wiz -l complete -d 'print hosts/flags matching prefix (completion backend)'
complete -c ssh-wiz -l completion -d 'print completion script (bash, zsh or fish)'
# fish filters the candidate list by the typed prefix itself
complete -c ssh-wiz -n '__fish_is_first_token' -a '(ssh-wiz --complete "")' -d 'host'
complete -c ssh-wiz -n '__fish_seen_argument -s f -s p -s t' -a '(ssh-wiz --complete "")' -d 'host'
""",
}


