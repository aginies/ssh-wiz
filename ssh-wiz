def hints_text() -> str:
    """Bottom-bar key hints; ^t is only shown when tmux is installed."""
    parts = ["?/F1: help", "type: filter", "⏎: connect",
             "^f: fav", "^o: opts"]
    if tmux_available():
        parts.append("^t: tmux")
    parts += ["^y: copy", "^e: edit", "^g: cats",
              "esc: clear", "^q: quit"]
    return "    ".join(parts)


