def _ssh_config_path() -> Path:
    """~/.ssh/config, or $SSH_CONFIG if set (ssh honors the same variable)."""
    return Path(os.environ.get("SSH_CONFIG")
                or (Path.home() / ".ssh" / "config")).expanduser()


SSH_CONFIG = _ssh_config_path()
CONFIG_DIR = Path.home() / ".config" / "ssh-wiz"
STATE_DIR = Path.home() / ".local" / "state" / "ssh-wiz"
FAVORITES_FILE = CONFIG_DIR / "favorites"
USAGE_FILE = STATE_DIR / "usage.json"
EXTRA_HOSTS_FILE = CONFIG_DIR / "hosts"
CATEGORIES_FILE = CONFIG_DIR / "categories"
OTHER_CATEGORY = "OTHER"
ALL_CATEGORY = "ALL"
CATEGORY_COLORS = ("green", "cyan", "magenta", "yellow", "blue", "red",
                   "bright_cyan", "bright_yellow")
USER_COLORS = ("bright_red", "bright_green", "bright_yellow", "bright_blue",
               "bright_magenta", "bright_cyan", "red", "green", "blue",
               "magenta", "cyan", "yellow", "grey82", "bright_black",
               "dark_orange", "bright_white")
AT_COLOR = "bold grey63"
COL_SEP = " │ "  # dim column separator in host rows
DECAY_SECONDS = 7 * 86400  # usage score decays exponentially (7-day time constant)


@dataclass
class Host:
    """One connectable host (~/.ssh/config entry or extra-hosts file line)."""
    name: str                 # config name / extra-hosts alias
    display: str              # plain 'user@host[:port]' (status lines, clipboard)
    target: str               # what is passed to ssh
    category: str = OTHER_CATEGORY
    user: str | None = None       # display only (ssh resolves it from config)
    host: str | None = None       # display only
    port: str | None = None       # display only
    cmd_port: str | None = None   # passed as -p (extra hosts aren't in config)
    principal: str | None = None  # GSSAPI-style user containing '@'
    identityfile: str | None = None
    extra: str = ""             # extra ssh args (extra hosts only)


def _valid_color(c: str) -> bool:
    try:
        Style.parse(c)
        return True
    except Exception:  # noqa: BLE001 - any parse failure means "not a valid color"
        return False


def user_color(user: str) -> str:
    """Stable per-user color (crc32, so it's the same across runs)."""
    return USER_COLORS[zlib.crc32(user.encode()) % len(USER_COLORS)]


def tmux_session_name(host: Host) -> str:
    """Per-host tmux session name (tmux forbids '.' and ':' in names)."""
    return "wiz-" + re.sub(r"[.:@]", "-", host.name)


def category_order(hosts: list[Host], rules: list) -> list:
    """[ALL, <cats in file order>, OTHER (if any host falls there)]."""
    cats = [ALL_CATEGORY]
    for cat, _pattern, _color in rules:
        if cat not in cats:
            cats.append(cat)
    if any(h.category == OTHER_CATEGORY for h in hosts):
        cats.append(OTHER_CATEGORY)
    return cats


def category_colors(hosts: list[Host], rules: list) -> dict:
    """{category: color} — explicit color from the rules wins,
    otherwise a distinct palette color by order of first appearance."""
    cats = category_order(hosts, rules)
    colors = {}
    for cat, _pattern, color in rules:
        if color and cat not in colors:
            colors[cat] = color
    for i, cat in enumerate(cats):
        if cat in (ALL_CATEGORY, OTHER_CATEGORY) or cat in colors:
            continue
        colors[cat] = CATEGORY_COLORS[max(0, i - 1) % len(CATEGORY_COLORS)]
    colors.setdefault(OTHER_CATEGORY, "grey62")
    return colors


# --------------------------------------------------------------- storage

def load_usage() -> dict:
    """{host: [connect timestamps]} — malformed entries are dropped, so a
    hand-edited usage.json can never crash the tool."""
    try:
        data = json.loads(USAGE_FILE.read_text())
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    usage = {}
    for name, ts in data.items():
        if not isinstance(ts, list):
            continue
        clean = [t for t in ts
                 if isinstance(t, (int, float)) and not isinstance(t, bool)]
        if clean:
            usage[name] = clean
    return usage


def record_use(name: str) -> None:
    usage = load_usage()
    ts = usage.get(name, [])
    ts.append(time.time())
    usage[name] = ts[-50:]
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = USAGE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(usage))
    os.replace(tmp, USAGE_FILE)


def usage_score(usage: dict, name: str, now: float) -> float:
    return sum(math.exp(-(now - t) / DECAY_SECONDS)
               for t in usage.get(name, []))


def load_favorites() -> list:
    try:
        text = FAVORITES_FILE.read_text()
    except OSError:
        return []
    return [l.strip() for l in text.splitlines()
            if l.strip() and not l.startswith("#")]


def toggle_favorite_file(name: str) -> bool:
    favs = load_favorites()
    if name in favs:
        favs.remove(name)
    else:
        favs.append(name)
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = FAVORITES_FILE.with_suffix(".tmp")
    tmp.write_text("\n".join(favs) + "\n")
    os.replace(tmp, FAVORITES_FILE)
    return name in favs


# ----------------------------------------------------------------- hosts

def _default_user() -> str:
    return os.environ.get("USER") or os.environ.get("LOGNAME") or "user"


def parse_ssh_config(path: Path) -> tuple[dict, list]:
    """Parse ~/.ssh/config -> (hosts dict, ordered names).

    ssh semantics: first value seen wins per host. Match blocks are skipped.
    Comments: a '#' at line start, or preceded by whitespace, starts a
    comment.
    """
    hosts: dict = {}
    order: list = []
    if not path.exists():
        return hosts, order
    current: list = []
    in_match = False
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 1)
        if len(parts) < 2:
            continue
        key, value = parts[0].lower(), parts[1].strip()
        m = re.search(r"(^|\s)#", value)
        if m:
            value = value[:m.start()].strip()
            if not value:
                continue
        if key == "match":
            in_match = True
            current = []
        elif key == "host":
            in_match = False
            current = [n for n in value.split() if not any(c in n for c in "*?")]
            for n in current:
                if n not in hosts:
                    hosts[n] = {"user": None, "port": None, "identityfile": None}
                    order.append(n)
        elif in_match or not current:
            continue
        elif key in ("user", "port", "identityfile"):
            for n in current:
                if hosts[n][key] is None:
                    hosts[n][key] = value
    return hosts, order


def parse_extra_hosts(path: Path) -> list:
    """~/.config/ssh-wiz/hosts — one per line:  name  user@host[:port]  [extra ssh args]"""
    entries = []
    if not path.exists():
        return entries
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 2)
        if len(parts) < 2:
            continue
        extra = parts[2] if len(parts) > 2 else ""
        if extra:
            try:
                shlex.split(extra)
            except ValueError:
                print(f"ssh-wiz: ignoring malformed extra args: {line!r}",
                      file=sys.stderr)
                extra = ""
        entries.append({
            "name": parts[0],
            "target": parts[1],
            "extra": extra,
        })
    return entries


def load_category_rules(path: Path) -> list:
    """~/.config/ssh-wiz/categories -> [(category, pattern, color|None), ...]."""
    rules = []
    if not path.exists():
        return rules
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 2)
        if len(parts) < 2:
            continue
        color = parts[2].strip() if len(parts) > 2 else None
        if color and not _valid_color(color):
            color = None
        rules.append((parts[0], parts[1].strip(), color))
    return rules


def categorize(name: str, rules: list) -> str:
    for cat, pattern, _color in rules:
        if fnmatch.fnmatchcase(name, pattern):
            return cat
    return OTHER_CATEGORY


def build_hosts(rules: list | None = None) -> list[Host]:
    if rules is None:
        rules = load_category_rules(CATEGORIES_FILE)
    cfg, order = parse_ssh_config(SSH_CONFIG)
    hosts = []
    for name in order:
        h = cfg[name]
        user = h["user"] or _default_user()
        port = h["port"]
        if "@" in user:  # e.g. GSSAPI principal: show host, user in parens
            display = name + (f":{port}" if port and port != "22" else "") + f" ({user})"
            hosts.append(Host(
                name=name, display=display, target=name,
                user=None, host=name, port=port, principal=user,
                identityfile=h["identityfile"],
                category=categorize(name, rules),
            ))
        else:
            display = f"{user}@{name}" + (f":{port}" if port and port != "22" else "")
            hosts.append(Host(
                name=name, display=display, target=name,
                user=user, host=name, port=port,
                identityfile=h["identityfile"],
                category=categorize(name, rules),
            ))
    for e in parse_extra_hosts(EXTRA_HOSTS_FILE):
        if any(h.name == e["name"] for h in hosts):
            continue
        target = e["target"]
        user, at, rest = target.partition("@")
        if not at:  # no user given: whole target is the host
            user, rest = "", target
        hostpart, port = rest, ""
        inner, sep, maybe_port = rest.rpartition(":")
        if sep and maybe_port.isdigit():
            if inner.startswith("[") and inner.endswith("]"):
                hostpart, port = inner[1:-1], maybe_port  # [v6]:port
            elif ":" not in inner:
                hostpart, port = inner, maybe_port  # host:port
        # else: bare host, or bare IPv6 (no port)
        user = user or _default_user()
        display = user + "@" + hostpart + (f":{port}" if port else "")
        hosts.append(Host(
            name=e["name"], display=display, target=target,
            user=user, host=hostpart, port=port or None,
            cmd_port=port or None,
            extra=e["extra"],
            category=categorize(e["name"], rules),
        ))
    return hosts


def _append_display(line: Text, h: Host) -> None:
    """Append the host's 'user@host[:port]' with per-user colors to line."""
    if h.principal:  # e.g. GSSAPI principal: host (user)
        line.append(h.host, style="bold")
        if h.port and h.port != "22":
            line.append(f":{h.port}", style="dim")
        line.append(f" ({h.principal})", style="dim")
    elif h.user:
        line.append(h.user, style=user_color(h.user))
        line.append("@", style=AT_COLOR)
        line.append(h.host, style="bold")
        if h.port and h.port != "22":
            line.append(f":{h.port}", style="dim")
    else:  # ad-hoc host: fall back to plain display
        line.append(h.display)


def rank_hosts(hosts: list[Host]) -> tuple[list[Host], set]:
    favs = set(load_favorites())
    usage = load_usage()
    now = time.time()

    def sort_key(h):
        return (0 if h.name in favs else 1,
                -usage_score(usage, h.name, now),
                h.name.lower())

    return sorted(hosts, key=sort_key), favs


def favorite_split(shown: list, favs: set) -> int:
    """Number of leading favorites in a ranked list (they form a prefix).

    rank_hosts puts favorites first; the list renders a separator line
    below the prefix when it is non-empty and not the whole list.
    """
    n = 0
    for h in shown:
        if h.name not in favs:
            break
        n += 1
    return n


def triage_hosts(shown: list, favs: set, cat_order: list) -> list:
    """Favorites first (rank order), then non-favorites grouped by category
    in cat_order (rank order within each group)."""
    by_cat: dict = {}
    for h in shown:
        if h.name not in favs:
            by_cat.setdefault(h.category, []).append(h)
    out = [h for h in shown if h.name in favs]
    for cat in cat_order:
        if cat != ALL_CATEGORY:
            out.extend(by_cat.pop(cat, []))
    out.extend(h for hs in by_cat.values() for h in hs)
    return out


def build_ssh_cmd(host: Host, password_mode: bool, tmux_mode: bool = False,
                  remote_cmd: list | None = None) -> list:
    cmd = ["ssh"]
    if tmux_mode:
        cmd.append("-t")
    if password_mode:
        cmd += ["-o", "PubkeyAuthentication=no"]
    if host.cmd_port:
        cmd += ["-p", host.cmd_port]
    if host.extra:
        try:
            cmd += shlex.split(host.extra)
        except ValueError:
            pass  # malformed extra args: already warned at parse time
    cmd.append(host.target)
    if tmux_mode:
        cmd += ["tmux", "new", "-A", "-s", tmux_session_name(host)]
    if remote_cmd:
        cmd += remote_cmd
    return cmd


def find_host(name: str) -> Host:
    for h in build_hosts():
        if h.name == name or h.target == name:
            return h
    return Host(name=name, display=name, target=name)


def fuzzy_match(needle: str, haystack: str) -> bool:
    """True if every char of needle appears in haystack, in order.

    A superset of substring: 'rzn9' matches 'ryzen9'.
    """
    it = iter(haystack)
    return all(ch in it for ch in needle)


def copy_to_clipboard(text: str) -> bool:
    """Copy text via the first available clipboard tool."""
    for tool in (["wl-copy"], ["xclip", "-selection", "clipboard"],
                 ["xsel", "--clipboard", "--input"], ["pbcopy"]):
        if shutil.which(tool[0]):
            try:
                subprocess.run(tool, input=text.encode(), check=True, timeout=2)
                return True
            except Exception:  # noqa: BLE001, S112 - just try the next clipboard tool
                continue
    return False


def find_config_line(name: str):
    """1-based line of the 'Host <name>' block in ~/.ssh/config, or None."""
    try:
        lines = SSH_CONFIG.read_text().splitlines()
    except OSError:
        return None
    for i, raw in enumerate(lines, 1):
        parts = raw.split(None, 1)
        if len(parts) >= 2 and parts[0].lower() == "host" and name in parts[1].split():
            return i
    return None


# ------------------------------------------------------------------- TUI

# Textual is imported here (not at the top) so the CLI paths (-l, -f, direct
# connect) start without paying for the TUI dependency.
from textual import events  # noqa: E402
from textual.app import App, ComposeResult, SuspendNotSupported  # noqa: E402
from textual.widget import Widget  # noqa: E402
from textual.widgets import Input, Static  # noqa: E402

HINTS = ("type: filter    ←→: cat    ↑↓: move    ⏎: connect    ^f: fav    "
         "^o: passwd    ^t: tmux    ^y: copy    ^e: edit    ^a: ad-hoc    "
         "esc: clear    ^q: quit")


class HostList(Widget):
    can_focus = True
    DEFAULT_CSS = """
    HostList {
        width: 100%;
        height: 1fr;
    }
    """

    def __init__(self) -> None:
        super().__init__(id="hostlist")
        self.hosts: list = []
        self.shown: list = []
        self.favs: set = set()
        self.cursor = 0
        self.filter = ""
        self.scroll = 0

    def apply_filter(self) -> None:
        f = self.filter.lower()
        cat = self.app.current_cat
        self.shown = [h for h in self.hosts
                      if (cat == ALL_CATEGORY or h.category == cat)
                      and (not f or fuzzy_match(f,
                           (h.name + " " + h.display + " " +
                            h.category).lower()))]
        if cat == ALL_CATEGORY:
            # triage: keep the favorites block, group the rest per category
            self.shown = triage_hosts(self.shown, self.favs,
                                      self.app.categories)
        self.cursor = min(self.cursor, max(0, len(self.shown) - 1))
        self.refresh()

    def render(self) -> Text:
        t = Text(no_wrap=True, end="")
        height = max(1, self.size.height)
        if not self.shown:
            msg = ("no hosts match" if self.filter
                   else "no hosts found — check ~/.ssh/config")
            t.append(f"  {msg}", style="dim")
            return t
        # Layout: top border below the top bar, favorites block, a dim
        # separator, then non-favorites grouped by category (ALL view) with
        # a header per group.
        n_fav = favorite_split(self.shown, self.favs)
        rows: list = [("sep", None)]
        rows.extend(("host", i) for i in range(n_fav))
        if 0 < n_fav < len(self.shown):
            rows.append(("sep", None))
        prev_cat = None
        for i in range(n_fav, len(self.shown)):
            h = self.shown[i]
            if self.app.current_cat == ALL_CATEGORY and h.category != prev_cat:
                rows.append(("hdr", h.category))
            rows.append(("host", i))
            prev_cat = h.category
        # Keep the cursor visible; when possible leave one row of lookahead
        # below it (at the end of the list the cursor sits on the last row).
        crow = rows.index(("host", self.cursor))
        self.scroll = min(self.scroll, crow)
        if crow >= self.scroll + height - 1:
            self.scroll = crow - height + 2
        self.scroll = max(0, self.scroll)
        for r in range(self.scroll, min(len(rows), self.scroll + height)):
            kind, ref = rows[r]
            line = Text()
            if kind == "sep":
                line.append("─" * max(1, self.size.width), style="dim")
            elif kind == "hdr":
                label = f" {ref} "
                line.append(label,
                            style="bold " + self.app.cat_colors.get(ref, ""))
                line.append("─" * max(0, self.size.width - len(label)),
                            style="dim")
            else:
                h = self.shown[ref]
                fav = h.name in self.favs
                line.append("★ " if fav else "  ",
                            style="yellow" if fav else "dim")
                line.append(f"{h.name:<32}", style="bold")
                line.append(COL_SEP, style="dim")
                _append_display(line, h)
                if h.identityfile:
                    line.append(COL_SEP, style="dim")
                    line.append(f"[{Path(h.identityfile).expanduser().name}]",
                                style="cyan dim")
                if ref == self.cursor:
                    line.stylize("reverse")
            t.append_text(line)
            t.append("\n")
        return t

    def on_resize(self, event) -> None:
        self.refresh()


class SSHWiz(App):
    TITLE = "ssh-wiz"

    CSS = """
    #status {
        height: 1;
        background: $primary-background;
        color: $text;
        padding: 0 1;
    }
    #tabs {
        height: 1;
        background: $surface;
        color: $text;
        padding: 0 1;
    }
    #adhoc {
        height: 1;
        margin: 0 1;
    }
    #adhoc.hidden {
        display: none;
    }
    #hints {
        height: 1;
        background: $surface;
        color: $text-muted;
        padding: 0 1;
    }
    """

    ENABLE_COMMAND_PALETTE = False

    def __init__(self) -> None:
        super().__init__()
        self.password_mode = False
        self.tmux_mode = False
        self.connecting = False
        self.categories = [ALL_CATEGORY]
        self.cat_colors = {}
        self.current_cat = ALL_CATEGORY

    def compose(self) -> ComposeResult:
        yield Static("", id="status")
        yield Static("", id="tabs")
        yield Input(placeholder="ad-hoc: user@host   (⏎ connect, esc cancel)",
                    id="adhoc")
        yield HostList()
        yield Static(HINTS, id="hints")

    # -- data

    def reload(self) -> None:
        rules = load_category_rules(CATEGORIES_FILE)
        hosts, favs = rank_hosts(build_hosts(rules))
        self.categories = category_order(hosts, rules)
        self.cat_colors = category_colors(hosts, rules)
        if self.current_cat not in self.categories:
            self.current_cat = ALL_CATEGORY
        hl = self.query_one(HostList)
        hl.hosts = hosts
        hl.favs = favs
        hl.apply_filter()
        self.update_tabs()
        self.update_status()

    def update_tabs(self) -> None:
        hl = self.query_one(HostList)
        counts: dict = {}
        for h in hl.hosts:
            counts[h.category] = counts.get(h.category, 0) + 1
        t = Text()
        for cat in self.categories:
            n = len(hl.hosts) if cat == ALL_CATEGORY else counts.get(cat, 0)
            color = self.cat_colors.get(cat, "")
            label = f" {cat} ({n}) "
            if cat == self.current_cat:
                t.append(label, style=f"{color} bold reverse")
            else:
                t.append(label, style=color)
        self.query_one("#tabs", Static).update(t)

    def switch_cat(self, delta: int) -> None:
        if len(self.categories) < 2:
            return
        i = self.categories.index(self.current_cat)
        self.current_cat = self.categories[(i + delta) % len(self.categories)]
        hl = self.query_one(HostList)
        hl.apply_filter()
        self.update_tabs()
        self.update_status()

    def update_status(self) -> None:
        hl = self.query_one(HostList)
        parts = []
        if self.password_mode:
            parts.append("[bold red]PASSWORD MODE[/] (-o PubkeyAuthentication=no)")
        if self.tmux_mode:
            parts.append("[bold green]TMUX[/] (tmux new -A -s wiz-<host>)")
        if hl.filter:
            parts.append(f"filter: [bold]{escape(hl.filter)}[/]")
        parts.append(f"{len(hl.shown)}/{len(hl.hosts)} hosts")
        self.query_one("#status", Static).update("   ".join(parts))

    def on_mount(self) -> None:
        self.query_one("#adhoc", Input).add_class("hidden")
        self.reload()
        self.query_one(HostList).focus()

    # -- actions

    def toggle_favorite(self) -> None:
        hl = self.query_one(HostList)
        if not hl.shown:
            return
        host = hl.shown[hl.cursor]
        is_fav = toggle_favorite_file(host.name)
        self.reload()
        for i, h in enumerate(hl.shown):
            if h.name == host.name:
                hl.cursor = i
                break
        hl.refresh()
        verb = "★ added to favorites" if is_fav else "removed from favorites"
        self.notify(f"{verb}: {host.name}", title="ssh-wiz")

    def connect_to(self, host: Host) -> None:
        if self.connecting:
            return
        cmd = build_ssh_cmd(host, self.password_mode, self.tmux_mode)
        self.connecting = True
        self.query_one("#status", Static).update(
            f"[bold cyan]⏳ ssh {escape(host.display)} — terminal handed over…[/]")
        record_use(host.name)
        try:
            with self.suspend():
                rc = subprocess.run(cmd, check=False).returncode
        except SuspendNotSupported:
            self.notify("terminal does not support suspend — run: " + " ".join(cmd),
                        severity="error")
            self.update_status()
            return
        finally:
            self.connecting = False
        self.reload()
        hl = self.query_one(HostList)
        for i, h in enumerate(hl.shown):
            if h.name == host.name:
                hl.cursor = i
                break
        hl.refresh()
        self.notify(f"ssh exit {rc}: {host.name}",
                    severity="information" if rc == 0 else "warning")

    def do_connect(self) -> None:
        hl = self.query_one(HostList)
        if not hl.shown:
            return
        self.connect_to(hl.shown[hl.cursor])

    def edit_config(self) -> None:
        hl = self.query_one(HostList)
        if not hl.shown:
            return
        host = hl.shown[hl.cursor]
        line = find_config_line(host.name)
        if line is None:
            line = 1
            self.notify(f"{host.name} not in ~/.ssh/config — opening top",
                        severity="warning")
        editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "vi"
        parts = shlex.split(editor)
        editor_bin = Path(parts[0]).name
        if editor_bin == "code":
            args = parts + ["-g", f"{SSH_CONFIG}:{line}"]
        elif editor_bin in ("vi", "vim", "nvim", "emacs", "micro"):
            args = parts + [f"+{line}", str(SSH_CONFIG)]
        else:
            args = parts + [str(SSH_CONFIG)]
            self.notify(f"{editor_bin} can't jump to a line — "
                        f"opened ~/.ssh/config at top", severity="warning")
        try:
            with self.suspend():
                subprocess.run(args, check=False)
        except SuspendNotSupported:
            self.notify("terminal does not support suspend", severity="error")
            return
        self.reload()

    def show_adhoc(self, show: bool) -> None:
        adhoc = self.query_one("#adhoc", Input)
        if show:
            adhoc.remove_class("hidden")
            adhoc.value = ""
            adhoc.focus()
        else:
            adhoc.add_class("hidden")
            self.query_one(HostList).focus()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        if event.input.id != "adhoc":
            return
        target = event.value.strip()
        self.show_adhoc(False)
        if target:
            self.connect_to(Host(name=target, display=target, target=target))

    # -- keys

    def on_key(self, event: events.Key) -> None:
        adhoc = self.query_one("#adhoc", Input)
        if "hidden" not in adhoc.classes:
            if event.key in ("escape", "ctrl+c", "ctrl+q"):
                self.show_adhoc(False)
                event.stop()
            return  # let the Input handle its own keys
        hl = self.query_one(HostList)
        key = event.key
        if key in ("ctrl+c", "ctrl+q"):
            self.exit()
            event.stop()
        elif key == "backspace":
            hl.filter = hl.filter[:-1]
            hl.apply_filter()
            self.update_status()
            event.stop()
        elif key == "escape":
            if hl.filter:
                hl.filter = ""
                hl.apply_filter()
                self.update_status()
            event.stop()
        elif key == "up":
            hl.cursor = max(0, hl.cursor - 1)
            hl.refresh()
            event.stop()
        elif key == "down":
            if hl.shown:
                hl.cursor = min(len(hl.shown) - 1, hl.cursor + 1)
            hl.refresh()
            event.stop()
        elif key == "home":
            hl.cursor = 0
            hl.refresh()
            event.stop()
        elif key == "end":
            hl.cursor = max(0, len(hl.shown) - 1)
            hl.refresh()
            event.stop()
        elif key == "pageup":
            hl.cursor = max(0, hl.cursor - max(1, hl.size.height - 2))
            hl.refresh()
            event.stop()
        elif key == "pagedown":
            hl.cursor = min(max(0, len(hl.shown) - 1),
                            hl.cursor + max(1, hl.size.height - 2))
            hl.refresh()
            event.stop()
        elif key == "enter":
            self.do_connect()
            event.stop()
        elif key in ("tab", "right"):
            self.switch_cat(1)
            event.stop()
        elif key in ("shift+tab", "backtab", "left"):
            self.switch_cat(-1)
            event.stop()
        elif key == "ctrl+f":
            self.toggle_favorite()
            event.stop()
        elif key == "ctrl+o":
            self.password_mode = not self.password_mode
            self.update_status()
            event.stop()
        elif key == "ctrl+t":
            self.tmux_mode = not self.tmux_mode
            self.update_status()
            event.stop()
        elif key == "ctrl+y":
            if hl.shown:
                host = hl.shown[hl.cursor]
                cmd = " ".join(build_ssh_cmd(host, self.password_mode))
                if copy_to_clipboard(cmd):
                    self.notify(f"copied: {cmd}")
                else:
                    self.notify(f"no clipboard tool (wl-copy/xclip/xsel/pbcopy) — {cmd}",
                                severity="warning")
            event.stop()
        elif key == "ctrl+e":
            self.edit_config()
            event.stop()
        elif key == "ctrl+a":
            self.show_adhoc(True)
            event.stop()
        elif key == "ctrl+r":
            self.reload()
            event.stop()
        elif event.is_printable:
            hl.filter += event.character
            hl.apply_filter()
            self.update_status()
            event.stop()


# ----------------------------------------------------------- completion

# Flags offered for '-...' prefixes (single source of truth; the completion
# scripts only encode argument positions).
CLI_FLAGS = ("-l", "--list", "-f", "-p", "--password", "-t", "--tmux",
             "--complete", "--completion", "-h", "--help")


def complete_candidates(prefix: str) -> list:
    """Completion candidates for prefix: flags (prefix match) if it starts
    with '-', otherwise host names (fuzzy, like the TUI filter)."""
    p = prefix.lower()
    if prefix.startswith("-"):
        return [f for f in CLI_FLAGS if f.startswith(p)]
    return [h.name for h in build_hosts() if fuzzy_match(p, h.name.lower())]


COMPLETION_SCRIPTS = {
    "bash": r"""# ssh-wiz bash completion — enable in .bashrc with:
#   eval "$(ssh-wiz --completion bash)"
__ssh_wiz() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    local hostpos=0
    COMPREPLY=()
    [[ "$COMP_CWORD" -eq 1 ]] && hostpos=1
    case "$prev" in -f|-p|-t) hostpos=1 ;; esac
    if [[ "$cur" == -* || "$hostpos" -eq 1 ]]; then
        local IFS=$'\n'
        COMPREPLY=( $(ssh-wiz --complete "$cur" 2>/dev/null) )
    fi
    # remote-command position: default (filename) completion applies
}
complete -o default -F __ssh_wiz ssh-wiz""",
    "zsh": r"""# ssh-wiz zsh completion — enable in .zshrc with:
#   eval "$(ssh-wiz --completion zsh)"
__ssh_wiz() {
    local cur="${words[CURRENT]}"
    local prev="${words[CURRENT-1]}"
    reply=()
    if [[ "$cur" == -* || "$CURRENT" -eq 2 || "$prev" == (-f -p -t) ]]; then
        local -a cands
        cands=("${(@f)$(ssh-wiz --complete "$cur" 2>/dev/null)}")
        (( ${#cands} )) && reply=($cands)
    else
        _files
    fi
}
(( $+functions[compdef] )) && compdef __ssh_wiz ssh-wiz""",
    "fish": r"""# ssh-wiz fish completion — enable in config.fish with:
#   ssh-wiz --completion fish | source
complete -c ssh-wiz -s l -l list -d 'list hosts (ranked), no TUI'
complete -c ssh-wiz -s f -r -d 'toggle favorite (takes host)'
complete -c ssh-wiz -s p -l password -d 'connect with -o PubkeyAuthentication=no'
complete -c ssh-wiz -s t -l tmux -d 'connect in per-host tmux session'
complete -c ssh-wiz -s h -l help -d 'show help'
complete -c ssh-wiz -l complete -d 'print hosts/flags matching prefix (completion backend)'
complete -c ssh-wiz -l completion -d 'print completion script (bash, zsh or fish)'
# fish filters the candidate list by the typed prefix itself
complete -c ssh-wiz -n '__fish_is_first_token' -a '(ssh-wiz --complete "")' -d 'host'
complete -c ssh-wiz -n '__fish_seen_argument -s f -s p -s t' -a '(ssh-wiz --complete "")' -d 'host'
""",
}


# ------------------------------------------------------------------ CLI

def main() -> None:
    args = sys.argv[1:]
    if not args:
        SSHWiz().run()
        return
    if args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    if args[0] == "--complete":
        prefix = args[1] if len(args) > 1 else ""
        for c in complete_candidates(prefix):
            print(c)
        return
    if args[0] == "--completion":
        shell = args[1] if len(args) > 1 else ""
        script = COMPLETION_SCRIPTS.get(shell)
        if script is None:
            sys.exit(f"ssh-wiz: unknown completion shell: {shell} "
                     f"(want bash, zsh or fish)")
        print(script)
        return
    if args[0] in ("-l", "--list"):
        rules = load_category_rules(CATEGORIES_FILE)
        hosts, favs = rank_hosts(build_hosts(rules))
        colors = category_colors(hosts, rules)
        console = Console()
        for h in hosts:
            line = Text()
            line.append("★ " if h.name in favs else "  ",
                        style="bold yellow" if h.name in favs else "dim")
            line.append(f"{h.name:<32}", style="bold")
            line.append(COL_SEP, style="dim")
            _append_display(line, h)
            if h.category and h.category != OTHER_CATEGORY:
                line.append(COL_SEP, style="dim")
                line.append(f"[{h.category}]",
                            style="bold " + colors.get(h.category, ""))
            if h.identityfile:
                line.append(COL_SEP, style="dim")
                line.append(f"[{Path(h.identityfile).expanduser().name}]",
                            style="cyan dim")
            console.print(line)
        return
    if args[0] == "-f":
        if len(args) < 2:
            sys.exit("ssh-wiz: -f requires a host name")
        on = toggle_favorite_file(args[1])
        print(f"{'★ favorite' if on else 'unfavorited'}: {args[1]}")
        return
    password_mode = False
    tmux_mode = False
    rest = []
    for a in args:
        if a in ("-p", "--password"):
            password_mode = True
        elif a in ("-t", "--tmux"):
            tmux_mode = True
        elif a.startswith("-") and len(a) > 1:
            sys.exit(f"ssh-wiz: unknown option: {a} (see -h)")
        else:
            rest.append(a)
    if not rest:
        print(__doc__.strip())
        return
    host = find_host(rest[0])
    remote_cmd = rest[1:]
    if tmux_mode and remote_cmd:
        sys.exit("ssh-wiz: cannot combine -t with a remote command")
    record_use(host.name)
    try:
        os.execvp("ssh", build_ssh_cmd(host, password_mode, tmux_mode, remote_cmd))
    except OSError as e:
        sys.exit(f"ssh-wiz: cannot run ssh: {e}")


if __name__ == "__main__":
    main()
