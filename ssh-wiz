#!/usr/bin/env python3
"""ssh-wiz — fast interactive SSH host picker (console TUI).

Hosts are read from ~/.ssh/config (or $SSH_CONFIG if set), plus optional
~/.config/ssh-wiz/hosts; categories from ~/.config/ssh-wiz/categories.
Favorites and most-recently-used hosts are kept at the top.

Usage:
  ssh-wiz              launch the interactive picker
  ssh-wiz -l           list hosts (ranked), no TUI
  ssh-wiz <host>       connect directly, no TUI
  ssh-wiz <host> cmd   connect and run cmd (and args) on the host
  ssh-wiz -p <host>    connect directly with -o PubkeyAuthentication=no
  ssh-wiz -t <host>    connect directly inside a per-host tmux session
  ssh-wiz -f <host>    toggle favorite
  ssh-wiz --complete <prefix>   print hosts/flags matching prefix (completion)
  ssh-wiz --completion <shell>  print completion script (bash, zsh or fish)
  ssh-wiz -h           this help

TUI keys:
  type      fuzzy-filter hosts (letters in order, e.g. 'rzn9' -> ryzen9)
  left/right  previous/next category   (tab/shift-tab also work)
  up/down   move cursor   (also PgUp/PgDn, Home/End)
  enter     connect to selected host
  ^f        toggle favorite for selected host
  ^o        toggle password mode (adds -o PubkeyAuthentication=no)
  ^t        toggle tmux mode (connect via: tmux new -A -s wiz-<host>)
  ^y        copy the ssh command for the selected host
  ^e        open ~/.ssh/config at the selected host ($EDITOR)
  ^a        ad-hoc connect (type user@host)
  ^r        refresh host list
  esc       clear filter / cancel ad-hoc
  ^q / ^c   quit
"""
from __future__ import annotations

import fnmatch
import json
import math
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import zlib
