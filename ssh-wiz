class HostList(Widget):
    can_focus = True
    DEFAULT_CSS = """
    HostList {
        width: 100%;
        height: 1fr;
    }
    """

    def __init__(self) -> None:
        super().__init__(id="hostlist")
        self.hosts: list = []
        self.shown: list = []
        self.favs: set = set()
        self.cursor = 0
        self.filter = ""
        self.scroll = 0

    def apply_filter(self) -> None:
        f = self.filter.lower()
        cat = self.app.current_cat
        self.shown = [h for h in self.hosts
                      if (cat == ALL_CATEGORY or h.category == cat)
                      and (not f or fuzzy_match(f,
                           (h.name + " " + h.display + " " +
                            h.category).lower()))]
        if cat == ALL_CATEGORY:
            # triage: keep the favorites block, group the rest per category
            self.shown = triage_hosts(self.shown, self.favs,
                                      self.app.categories)
        self.cursor = min(self.cursor, max(0, len(self.shown) - 1))
        self.refresh()

    def render(self) -> Text:
        t = Text(no_wrap=True, end="")
        height = max(1, self.size.height)
        if not self.shown:
            msg = ("no hosts match" if self.filter
                   else "no hosts found — check ~/.ssh/config")
            t.append(f"  {msg}", style="dim")
            return t
        # Layout: favorites block, a dim separator, then non-favorites
        # grouped by category (ALL view) with a header per group. (The top
        # line above the list is drawn by CmdLine.)
        n_fav = favorite_split(self.shown, self.favs)
        rows: list = []
        rows.extend(("host", i) for i in range(n_fav))
        if 0 < n_fav < len(self.shown):
            rows.append(("sep", None))
        prev_cat = None
        for i in range(n_fav, len(self.shown)):
            h = self.shown[i]
            if self.app.current_cat == ALL_CATEGORY and h.category != prev_cat:
                rows.append(("hdr", h.category))
            rows.append(("host", i))
            prev_cat = h.category
        # Keep the cursor visible; when possible leave one row of lookahead
        # below it (at the end of the list the cursor sits on the last row).
        crow = rows.index(("host", self.cursor))
        self.scroll = min(self.scroll, crow)
        if crow >= self.scroll + height - 1:
            self.scroll = crow - height + 2
        self.scroll = max(0, self.scroll)
        for r in range(self.scroll, min(len(rows), self.scroll + height)):
            kind, ref = rows[r]
            line = Text()
            if kind == "sep":
                line.append("─" * max(1, self.size.width), style="dim")
            elif kind == "hdr":
                label = f" {ref} "
                line.append(label,
                            style="bold " + self.app.cat_colors.get(ref, ""))
                line.append("─" * max(0, self.size.width - len(label)),
                            style="dim")
            else:
                h = self.shown[ref]
                fav = h.name in self.favs
                line.append("★ " if fav else "  ",
                            style="yellow" if fav else "dim")
                line.append(f"{(h.label or h.name):<32}", style="bold")
                line.append(COL_SEP, style="dim")
                _append_display(line, h)
                if h.identityfile:
                    line.append(" ")
                    line.append(f"[{Path(h.identityfile).expanduser().name}]",
                                style="cyan dim")
                if ref == self.cursor:
                    line.stylize("reverse")
            t.append_text(line)
            t.append("\n")
        return t

    def on_resize(self, event) -> None:
        self.refresh()


class OptionsPanel(Widget):
    """The ^o panel: one row per ssh option. ↑↓ selects, ←/→/⏎ cycles the
    selected option's value (off → v1 → … → off). Keys are handled by the
    app (see SSHWiz.options_key)."""
    can_focus = True
    DEFAULT_CSS = """
    OptionsPanel {
        width: 100%;
        height: auto;
        max-height: 12;
        background: $surface;
        display: none;
        padding: 0 1;
        border-bottom: heavy $border;
    }
    """

    def __init__(self) -> None:
        super().__init__()
        self.cursor = 0

    def render(self):
        app = self.app
        t = Text()
        t.append(" ssh options", style="bold")
        t.append("      ←→/⏎: value    esc: close", style="dim")
        for i, (label, _values) in enumerate(app.options):
            cur = app.option_state.get(label, "")
            row = Text()
            prefix = "→ " if i == self.cursor else "  "
            style = "bold reverse" if i == self.cursor else ""
            row.append(f"{prefix}{label:<10}", style=style)
            if cur:
                row.append(f" {cur}", style="bold")
            else:
                row.append(" off", style="dim")
            t.append("\n")
            t.append_text(row)
