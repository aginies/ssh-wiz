        "  ^o          ssh options panel (↑↓ select, ←→/⏎ cycle, esc close)",
    ]
    if tmux_available():
        lines.append("  ^t          toggle tmux mode (tmux new -A -s wiz-<host>)")
    lines += [
        "  ^y          copy the ssh command for the selected host",
        "  ^e          open ~/.ssh/config at the selected host",
        "  ^g          open categories file, then refresh",
        "  ^h          (terminals send backspace for ^h, so use ? / F1)",
        "  ? / F1      this help",
        "  ^r          refresh host list",
        "  esc         clear filter / close panel",
        "  ^q / ^c     quit",
    ]
    return "\n".join(lines) + "\n"


